{
  "manifest_version": 3,
  "name": "3P Matrix — content firewall",
  "short_name": "3P Matrix",
  "version": "5.1.9",
  "description": "Content firewall: levels 1–5 for third-party content, privacy & security protections, and warnings for suspicious sites.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation",
    "webRequest",
    "tabs",
    "scripting",
    "downloads",
    "alarms",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "3P Matrix — content firewall",
    "default_icon": {
      "16": "icons/icon_1_16.png",
      "32": "icons/icon_1_32.png",
      "48": "icons/icon_1_48.png",
      "128": "icons/icon_1_128.png"
    }
  },
  "options_ui": {
    "page": "ui/protections.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon_1_16.png",
    "32": "icons/icon_1_32.png",
    "48": "icons/icon_1_48.png",
    "128": "icons/icon_1_128.png"
  }
}
